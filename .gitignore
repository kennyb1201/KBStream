local.properties
.env
.env.*
*.iml
.gradle/
.kotlin/
build/
app/build/
.idea/
__pycache__/
*.pyc
# Scratch from the local tooling: the anchored edit specs handed to
# scripts/patch_source.py, and probe output redirected out of the tmdb_*.py
# scripts. Neither is source, and neither belongs in a commit.
scripts/_*.json
scripts/*.txt
# Multi-MB native binaries the build consumes but never vendors in git:
# the video-enabled FFmpeg decoder extension (scripts/build_ffmpeg_video.sh,
# or the "Build FFmpeg video extension" workflow artifact), and the MPV
# engine's AAR (scripts/fetch_mpv_aar.sh, fetched into app/libs/). The pattern
# has no leading slash, so it covers both the repo-root libs/ and app/libs/.
libs/
# libass JNI bridge (scripts/build_libass.sh, or the "Build libass JNI
# library" workflow artifact). Dropped into the default jniLibs source set so
# Gradle packages it with no build-file wiring, and gitignored for the same
# reason as libs/: a multi-MB native binary that the app must keep working
# without (AssNative.available reports its absence).
app/src/main/jniLibs/

<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.PICTURE_IN_PICTURE" />
    <!-- In-app self-update: lets the system offer the install prompt for a
         downloaded APK (sideloaded builds are not Play-managed). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- New-episode alerts. Runtime-requested on Android 13+ (requested when
         the toggle is switched on); a no-op grant on older releases. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice search: let the system speech RecognizerIntent resolve on
         Android 11+ (package visibility filtering). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".MainApplication"
        android:label="KBStream"
        android:banner="@mipmap/ic_launcher"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.KBStream">

        <!-- Sentry is initialized programmatically in MainApplication so the
             DSN can come from build config; disable the SDK's auto-init. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- System / voice search target: the TV remote's mic (and assistant
             queries) arrive here as ACTION_SEARCH and are forwarded to
             MainActivity with the query, which opens the Search screen with it
             already submitted. Transparent, never in Recents. -->
        <activity
            android:name=".ui.search.VoiceSearchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

        <activity
            android:name=".ui.player.NativePlayerActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:screenOrientation="landscape" />

        <!-- Self-update fallback flow: shares the downloaded APK with the
             system installer via a content URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${packageName}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!-- Self-update: receives the PackageInstaller session status after
             commit(). When the system answers STATUS_PENDING_USER_ACTION this
             receiver launches the install-confirmation dialog; without it the
             update flow would hang on "handing to the system installer".
             Not exported: only the system and this app target it. -->
        <receiver
            android:name="com.kennyb1201.kbstream.data.update.AppUpdater$InstallStatusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.kennyb1201.kbstream.action.INSTALL_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

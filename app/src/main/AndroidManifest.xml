<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- minSdk is 26, above the MPV engine AAR's own floor (mpvlibAndroid
         declares 24), so no tools:overrideLibrary is needed here. -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The phone-as-a-remote channel (spec 2026-11-13). The TV advertises over
         Android NSD and binds its socket to its own LAN address only; the phone
         discovers on the current Wi-Fi and refuses to look on mobile data, which
         is what needs the network-state permission. Nothing here reaches the
         internet, and no account, token or cloud relay is involved. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- NSD advertises over multicast on some networks; declaring this lets the
         device participate when the platform requires the lock, and costs
         nothing when it does not. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- No PICTURE_IN_PICTURE permission: it is not a platform permission. PiP
         is granted per activity by android:supportsPictureInPicture, which the
         two player activities already declare; the line here was dead weight
         that only ever showed up in the scanned permission list. -->
    <!-- In-app self-update: lets the system offer the install prompt for a
         downloaded APK (sideloaded builds are not Play-managed). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- New-episode alerts. Runtime-requested on Android 13+ (requested when
         the toggle is switched on); a no-op grant on older releases. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Offline downloads. The download runs in a foreground service (a
         4 GB transfer is not something the platform will let a background
         process finish), so the service permission is required, and API 34+
         requires the DATA_SYNC type-specific one beside it because that is the
         type videos download under. Additive only: on a television nothing ever
         starts the service, so neither permission is ever exercised there. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android TV launcher "Watch Next" rows: the launcher's Continue
         watching rail, published by TvLauncherPublisher.

         Some TV providers enforce this permission on the Watch Next table
         (the TCL/Realtek box this was debugged on denies the insert with
         "requires com.android.providers.tv.permission.WRITE_EPG_DATA" without
         it). On a box where the permission is privileged it is simply never
         granted, and the publisher stops after the first denial instead of
         retrying on every sync. -->
    <uses-permission
        android:name="com.android.providers.tv.permission.WRITE_EPG_DATA"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility. Android 11+ filters what this app is allowed to see,
         and an implicit query only returns apps declared here.

         Two features depend on it: voice search needs the system recognizer,
         and the External player engine needs every installed video player's
         picker entry. Without the VIEW intents below, queryIntentActivities is
         filtered even when starting the intent is not, so a box with VLC
         installed could show an empty player list - and the external engine
         would report "no external player found" for a player sitting right
         there. Each MIME type needs its own <intent>: multiple <data> children
         of one element are AND-ed, not OR-ed. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/x-mpegURL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/vnd.apple.mpegurl" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/dash+xml" />
        </intent>
        <!--
             Scheme-only players: an app that registers NO video VIEW filter
             and is reachable only through its own URL scheme.

             VidHub is the one that matters. On Android and Android TV it
             publishes `open-vidhub://x-callback-url/play` for third-party
             integration instead of a video MIME filter, so on Android 11+ it
             is invisible to the external-player probe unless this entry
             declares the scheme (see ExternalPlayer's SCHEME_PLAYERS, which
             queries exactly this URI).

             Deliberately the scheme alone, with no host or path: a player is
             free to match the request on any part of it, and the query only
             has to find the resolver - the request itself is built to the
             player's own documented shape.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="open-vidhub" />
        </intent>
        <!--
             Every app the viewer can open, for Settings' "choose custom app"
             picker (ExternalPlayer.allApps).

             The same Android 11+ rule as everything above: an app that this
             manifest does not declare is invisible to queryIntentActivities, so
             a picker of "all installed apps" is exactly as long as what is
             declared here. Both launcher categories are declared because a TV
             build normally registers only the leanback one - that is the shape
             of the case the picker exists for (a Play Store TV build of a
             player that declares no video VIEW filter, so no probe can find
             it).

             The launcher categories rather than QUERY_ALL_PACKAGES: it needs no
             permission, Play does not restrict it, and an app nobody can open
             from the launcher is not one anybody can use as a player.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <!--
         required=false, deliberately: this manifest also carries a plain
         LAUNCHER category and the app targets API 36 (the phone/tablet/foldable
         requirement), so the AAB is meant for those form factors too. A
         REQUIRED leanback feature is a Play device filter - it hid the app from
         every non-TV device, which is the opposite of what the launcher entry
         and the tablet work are for. The TV entry keeps its own
         LEANBACK_LAUNCHER category below; a TV box that declares leanback still
         gets the banner icon and D-pad home screen.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- largeHeap: the app buffers video sample data on the Java heap (media3's
         DefaultAllocator hands out byte[] blocks), and on the TV boxes this
         ships to the default cap is only ~192 MB. A 4K Dolby Vision release
         buffered for 30 s needs more than that on its own, so playback OOMed
         and took the process down. The heap class is what the player's buffer
         budget is derived from (see the DefaultLoadControl setup), so raising
         it raises the budget with it. -->
    <!-- banner: Leanback/Google TV draws this itself across the launcher's
         card, so it has to be the 320x180dp artwork (@drawable/tv_banner)
         rather than the square icon, which a TV launcher letterboxes into a
         blurred strip. It is the ORIGINAL full-bleed plate: opaque, edge to
         edge, with the full-size lockup. The inset/translucent variants are
         NOT in the APK any more (m36: they shipped unused and were stripped by
         shrinkResources anyway); scripts/render_brand_assets.py still draws
         them, so point android:banner at one of those after regenerating it to
         swap cards.
         icon: the adaptive plate + play mark for every other surface.
         Everything is generated by scripts/render_brand_assets.py; nothing
         is hand-edited. -->
    <!-- allowBackup=false: Android Auto Backup would sweep this app's data
         directory into cloud backup / `adb backup`, and nothing here needs to
         survive a device transfer — a new install signs in again and the
         watched state re-pulls from sync.

         The BEARER credentials are no longer the reason (this comment used to
         say they were plain MODE_PRIVATE files): the Supabase refresh token,
         the Simkl access token and the MDBList / OpenSubtitles / TorBox API
         keys now live in `SecureTokenStore`'s EncryptedSharedPreferences,
         whose master key is in the AndroidKeyStore and never leaves the
         device. What still argues for the flag is everything else in the same
         directory: the watch-history database, the IPTV playlist and EPG
         files, the addon catalog snapshots and the display/profile prefs
         blobs. None of it is worth carrying off a device. -->
    <!-- Cleartext HTTP is permitted app-wide so user-supplied IPTV/addon
         sources and the http:// LAN pairing handoff keep working. That is a
         deliberate tradeoff, not an oversight: the reasoning, the accepted
         risk and how to tighten it are documented in
         res/xml/network_security_config.xml. -->
    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.KBStream">

        <!-- Sentry is initialized programmatically in MainApplication so the
             DSN can come from build config; disable the SDK's auto-init. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!-- android:theme is the launch splash: the system paints its window
             background (the centred brass mark on the void) until this app
             composes its first frame, which is where the branded splash takes
             over. MainActivity.onCreate swaps to Theme.KBStream before
             super.onCreate, so the splash theme is only ever that pre-Compose
             frame - see Theme.KBStream.Splash. -->
        <!-- Orientation stays exactly where the tagged build had it: the
             manifest's landscape lock is the TV window policy, and the TV path
             makes no programmatic orientation call at all. A phone overrides it
             with FormFactor.applyOrientation before super.onCreate (see
             FormFactor), which is why one artifact can serve both.
             resizeableActivity is manifest-only, and true is what a phone needs
             for multi-window and foldable continuity; Android TV does not use
             multi-window, so the TV layout should be unaffected. -->
        <!-- configChanges: MainActivity asks for landscape while its own
             pre-playback splash is up (the splash is a screen of THIS window,
             not the player's - see AppRoot in MainActivity.kt). Declaring the
             rotation here is what makes that request rotate the window instead
             of re-creating the activity: a re-create mid-resolve would drop the
             in-flight autoplay (its pending target is composition state) and
             repaint the splash portrait, which is the flip the request exists
             to remove. The three player activities already declare this same
             set. density and uiMode are deliberately NOT here, so those still
             re-create as before, and screenOrientation above is untouched: it
             is the TV policy, and a phone still clears it in onCreate. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:screenOrientation="landscape"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:theme="@style/Theme.KBStream.Splash"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- The launcher shortcuts (Continue Watching, Search, Library) and
                 the Assistant capabilities, including "play <title>" (spec
                 2026-11-13, F1 and F3). `shortcuts.xml` is the file Google
                 moved App Actions to; `actions.xml` is deprecated.

                 The shortcut and feature intents are resolved through THIS
                 filter rather than by package name: shortcuts.xml is a resource
                 file, so it cannot carry the `${packageName}` placeholder, and
                 a hardcoded package would aim the debug install's shortcuts at
                 the release app (two installs side by side, see
                 DebugSideBySideContractTest). destination = the path segment:
                 continue_watching / search / library, read by AssistantLaunch. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="kbstream"
                    android:host="assistant" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- System / voice search target: the TV remote's mic (and assistant
             queries) arrive here as ACTION_SEARCH and are forwarded to
             MainActivity with the query, which opens the Search screen with it
             already submitted.

             The second filter is the media action a TV launcher or an assistant
             dispatches for "play <title>": the query is resolved to one result
             and that title's own screen opens, ready to play (see
             VoiceSearchActivity). Transparent, never in Recents. -->
        <activity
            android:name=".ui.search.VoiceSearchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- The Assistant's "play <title>" custom intent (spec 2026-11-13,
                 F1; see res/xml/shortcuts.xml). Same handler as the media
                 action above - the activity routes both into
                 resolveSpokenTitle - but under this app's OWN action, so the
                 fulfillment cannot land in another installed media app that
                 also declares the platform's media filter. Named in
                 AssistantLaunch.ACTION_PLAY_TITLE. -->
            <intent-filter>
                <action android:name="com.kennyb1201.kbstream.action.PLAY_TITLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- A picked global-search suggestion: the row's own
                 SUGGEST_COLUMN_INTENT_DATA (a kbstream://title/... link
                 carrying the TMDB id) is resolved here into the title's detail
                 screen, the same way a spoken title is. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="kbstream"
                    android:host="title" />
            </intent-filter>
            <!-- MyAnimeList's OAuth callback (spec 2026-11-13, F1):
                 kbstream://oauth/mal?code=...&state=... after the viewer approves
                 on the web. The redirect_uri registered on MAL's app page is this
                 exact scheme+host+path (MalConfig.REDIRECT_URI), and MAL refuses
                 an authorize request that names anything else. The same filter
                 receives ?connect=1, which a TV shows as a QR code so the PHONE
                 can run the flow. BROWSABLE is what lets a browser hand the
                 redirect back; DEFAULT is what makes the link resolvable at all. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="kbstream"
                    android:host="oauth"
                    android:pathPrefix="/mal" />
            </intent-filter>
            <!-- AniList's code-grant callback (spec 2026-11-14, F3):
                 kbstream://oauth/anilist?code=...&state=... after the viewer
                 approves on AniList. The redirect_uri registered on the app's
                 AniList page is this exact scheme+host+path, and AniList rejects
                 an authorize request naming anything else. BROWSABLE is what lets
                 the browser hand the redirect back. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="kbstream"
                    android:host="oauth"
                    android:pathPrefix="/anilist" />
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

        <!-- Global-search suggestions for the TV launcher: the rows the system's
             search box draws while the viewer types. Exported because the
             launcher queries it from its own process - which is what every
             global-search provider does - and read-only besides: it answers only
             with titles matching the query it is handed, stores nothing and
             enumerates nothing.

             The authority follows the applicationId so a debug build installed
             beside the release gets its own (`...kbstream.debug.search`). Two
             installed packages cannot publish the same provider authority, and
             the debug install is exactly that second package. -->
        <provider
            android:name=".ui.search.SearchSuggestionsProvider"
            android:authorities="${packageName}.search"
            android:exported="true" />

        <!-- configChanges is the set the other two engines declare. density and
             uiMode are the easy ones to leave out and the expensive ones to
             leave out: a TV switches display mode (resolution / HDR) a second
             or two into playback, and an UNDECLARED change recreates the
             activity - the decoder is torn down and a fresh one built
             mid-title, which reads as a black screen with a spinner flashing
             and then the film simply carrying on. -->
        <activity
            android:name=".ui.player.NativePlayerActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density|uiMode"
            android:screenOrientation="landscape" />

        <!-- Backup engine (MPV). Takes the same launch extras as
             NativePlayerActivity, so a failed ExoPlayer session hands its own
             intent over mid-title (see NativePlayerActivity.handOffToMpv) and
             the Settings "Player engine" choice can open it directly.
             Resizable/PiP like the main player: this is the engine anime and
             Dolby Vision titles land on, so a Home press had to pop exactly
             those sessions into the corner instead of dropping out of what was
             playing. The guards both engines share are in PipSupport. -->
        <activity
            android:name=".ui.player.MpvPlayerActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density|uiMode"
            android:screenOrientation="landscape" />

        <!-- Offline downloads (mobile only). The service media3's DownloadManager
             runs its transfers in. Declared here and nowhere else: no TV screen
             starts it, so a television build gains a declaration it never
             exercises rather than a new entry point (spec §8).

             exported=false because only this app's own `DownloadService.send*`
             calls start it - a download started by another app would be a
             download this app has no record of.

             foregroundServiceType=dataSync is the type a transfer belongs to
             (API 34+ requires it, and requires the matching permission above).

             Deliberately NO media3 scheduler intent-filter: the filter exists so
             a JobScheduler-driven restart can re-arm the service after a reboot,
             and this app resumes what is unfinished from
             DownloadsManager.start() on every launch instead of adding a second
             scheduling mechanism (see DownloadsService). -->
        <service
            android:name=".data.download.DownloadsService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Third engine (External player). Hands the stream to an installed
             video app (VLC, MX Player, Kodi) and keeps the SESSION here: the
             playhead, the watch-history row, both scrobblers and the
             end-of-episode panels all belong to this activity, which is why
             the title is handed over with startActivityForResult rather than
             a plain launch. Same launch extras as the other two engines. -->
        <activity
            android:name=".ui.player.ExternalPlayerActivity"
            android:exported="false"
            android:resizeableActivity="false"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density|uiMode"
            android:screenOrientation="landscape" />

        <!-- Self-update fallback flow: shares the downloaded APK with the
             system installer via a content URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${packageName}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!-- Self-update: receives the PackageInstaller session status after
             commit(). When the system answers STATUS_PENDING_USER_ACTION this
             receiver launches the install-confirmation dialog; without it the
             update flow would hang on "handing to the system installer".
             Not exported: only the system and this app target it. -->
        <receiver
            android:name="com.kennyb1201.kbstream.data.update.AppUpdater$InstallStatusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.kennyb1201.kbstream.action.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <!-- Continue Watching home-screen widget (spec 2026-11-13).

             The receiver is the only component the launcher binds to, so it is
             exported and carries the appwidget action. The refresh action is
             this app's own broadcast, received here and nowhere else.

             The widget needs NO permission of its own: it reads a file in this
             app's storage and starts this app's activity. (`BIND_REMOTEVIEWS`
             below is the service's permission, held by the system's launcher
             host, not one this app requests.) -->
        <receiver
            android:name=".widget.CwWidgetProvider"
            android:exported="true"
            android:label="@string/cw_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.kennyb1201.kbstream.widget.action.CW_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cw_widget_info" />
        </receiver>

        <!-- The widget's rows. Bound by the launcher host through the widget,
             with the system permission that keeps any other app from calling
             it; not exported, no intent filter. -->
        <service
            android:name=".widget.CwWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>

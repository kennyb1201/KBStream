<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- minSdk is 26, matching libmpv's own floor, so no tools:overrideLibrary
         is needed here. -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.PICTURE_IN_PICTURE" />
    <!-- In-app self-update: lets the system offer the install prompt for a
         downloaded APK (sideloaded builds are not Play-managed). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- New-episode alerts. Runtime-requested on Android 13+ (requested when
         the toggle is switched on); a no-op grant on older releases. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android TV launcher "Watch Next" rows: the launcher's Continue
         watching rail, published by TvLauncherPublisher.

         Some TV providers enforce this permission on the Watch Next table
         (the TCL/Realtek box this was debugged on denies the insert with
         "requires com.android.providers.tv.permission.WRITE_EPG_DATA" without
         it). On a box where the permission is privileged it is simply never
         granted, and the publisher stops after the first denial instead of
         retrying on every sync. -->
    <uses-permission
        android:name="com.android.providers.tv.permission.WRITE_EPG_DATA"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility. Android 11+ filters what this app is allowed to see,
         and an implicit query only returns apps declared here.

         Two features depend on it: voice search needs the system recognizer,
         and the External player engine needs every installed video player's
         picker entry. Without the VIEW intents below, queryIntentActivities is
         filtered even when starting the intent is not, so a box with VLC
         installed could show an empty player list - and the external engine
         would report "no external player found" for a player sitting right
         there. Each MIME type needs its own <intent>: multiple <data> children
         of one element are AND-ed, not OR-ed. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/x-mpegURL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/vnd.apple.mpegurl" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/dash+xml" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- largeHeap: the app buffers video sample data on the Java heap (media3's
         DefaultAllocator hands out byte[] blocks), and on the TV boxes this
         ships to the default cap is only ~192 MB. A 4K Dolby Vision release
         buffered for 30 s needs more than that on its own, so playback OOMed
         and took the process down. The heap class is what the player's buffer
         budget is derived from (see the DefaultLoadControl setup), so raising
         it raises the budget with it. -->
    <!-- banner: Leanback/Google TV draws this itself across the launcher's
         card, so it has to be the 320x180dp artwork (@drawable/tv_banner)
         rather than the square icon, which a TV launcher letterboxes into a
         blurred strip. It is the ORIGINAL full-bleed plate: opaque, edge to
         edge, with the full-size lockup. The inset/translucent variants ship
         in the APK too (@drawable/tv_banner_plate, @drawable/tv_banner_
         translucent); point android:banner at one of those to swap cards.
         icon: the adaptive plate + play mark for every other surface.
         Everything is generated by scripts/render_brand_assets.py; nothing
         is hand-edited. -->
    <!-- allowBackup=false: the app keeps the Supabase refresh token and the
         MDBList/OMDb/OpenSubtitles API keys in ordinary MODE_PRIVATE
         SharedPreferences (no EncryptedSharedPreferences), and Android Auto
         Backup would sweep those files into cloud backup / `adb backup`.
         Nothing here needs to survive a device transfer — a new install signs
         in again and the watched state re-pulls from sync. -->
    <!-- Cleartext HTTP is permitted app-wide so user-supplied IPTV/addon
         sources and the http:// LAN pairing handoff keep working. That is a
         deliberate tradeoff, not an oversight: the reasoning, the accepted
         risk and how to tighten it are documented in
         res/xml/network_security_config.xml. -->
    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:largeHeap="true"
        android:label="KBStream"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.KBStream">

        <!-- Sentry is initialized programmatically in MainApplication so the
             DSN can come from build config; disable the SDK's auto-init. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- System / voice search target: the TV remote's mic (and assistant
             queries) arrive here as ACTION_SEARCH and are forwarded to
             MainActivity with the query, which opens the Search screen with it
             already submitted.

             The second filter is the media action a TV launcher or an assistant
             dispatches for "play <title>": the query is resolved to one result
             and that title's own screen opens, ready to play (see
             VoiceSearchActivity). Transparent, never in Recents. -->
        <activity
            android:name=".ui.search.VoiceSearchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

        <!-- configChanges is the set the other two engines declare. density and
             uiMode are the easy ones to leave out and the expensive ones to
             leave out: a TV switches display mode (resolution / HDR) a second
             or two into playback, and an UNDECLARED change recreates the
             activity - the decoder is torn down and a fresh one built
             mid-title, which reads as a black screen with a spinner flashing
             and then the film simply carrying on. -->
        <activity
            android:name=".ui.player.NativePlayerActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density|uiMode"
            android:screenOrientation="landscape" />

        <!-- Backup engine (MPV). Takes the same launch extras as
             NativePlayerActivity, so a failed ExoPlayer session hands its own
             intent over mid-title (see NativePlayerActivity.handOffToMpv) and
             the Settings "Player engine" choice can open it directly.
             Resizable/PiP like the main player: this is the engine anime and
             Dolby Vision titles land on, so a Home press had to pop exactly
             those sessions into the corner instead of dropping out of what was
             playing. The guards both engines share are in PipSupport. -->
        <activity
            android:name=".ui.player.MpvPlayerActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density|uiMode"
            android:screenOrientation="landscape" />

        <!-- Third engine (External player). Hands the stream to an installed
             video app (VLC, MX Player, Kodi) and keeps the SESSION here: the
             playhead, the watch-history row, both scrobblers and the
             end-of-episode panels all belong to this activity, which is why
             the title is handed over with startActivityForResult rather than
             a plain launch. Same launch extras as the other two engines. -->
        <activity
            android:name=".ui.player.ExternalPlayerActivity"
            android:exported="false"
            android:resizeableActivity="false"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density|uiMode"
            android:screenOrientation="landscape" />

        <!-- Self-update fallback flow: shares the downloaded APK with the
             system installer via a content URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${packageName}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!-- Self-update: receives the PackageInstaller session status after
             commit(). When the system answers STATUS_PENDING_USER_ACTION this
             receiver launches the install-confirmation dialog; without it the
             update flow would hang on "handing to the system installer".
             Not exported: only the system and this app target it. -->
        <receiver
            android:name="com.kennyb1201.kbstream.data.update.AppUpdater$InstallStatusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.kennyb1201.kbstream.action.INSTALL_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

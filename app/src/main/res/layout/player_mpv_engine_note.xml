<?xml version="1.0" encoding="utf-8"?>
<!-- The MPV engine's one note: which source is playing, which engine is playing
     it, and what mpv ended up decoding, filled from mpv's own properties once the
     file opens. It is engine-specific (ExoPlayer has no equivalent), so it is NOT
     in the shared player_chrome.xml: the activity inflates it into that layout's
     `chrome_extra_note` slot, exactly where it used to sit - pinned under the
     source badge row, in the accent tone. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mpv_engine_note"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="2dp"
    android:ellipsize="end"
    android:fontFamily="@font/oswald_medium"
    android:maxLines="2"
    android:textColor="@color/kb_accent"
    android:textSize="14sp"
    android:visibility="gone" />

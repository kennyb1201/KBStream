<?xml version="1.0" encoding="utf-8"?>
<!-- MPV backup player. The chrome is deliberately the same as
     activity_player.xml's: same gradient overlay, same Oswald type, same icon
     buttons in the same order, same 360dp settings side panel - so a session
     that lands here after ExoPlayer gives up looks and drives like any other.

     The overlay itself is no longer written out here: it is the shared
     player_chrome.xml, included below, wired once for both engines. This layout
     now carries only what is this engine's own - the surface, the splash, the
     error card, the end-of-episode cards, the side panels, and the pieces the
     shared chrome cannot hold for it (see the includes and slots below).

     What is missing is missing because libmpv cannot do it, not by choice: no
     Dolby Vision / P5 controls (mpv has no DV path). Those replacements live in
     the settings panel behind the gear, which is where the engine-specific
     controls sit. The overlay carries the same title block and the same source
     badge chips as the main player's, and nothing else: what is playing is the
     badges' job and how it is being played belongs to the INFO readout.

     The source button IS here, and so is the picker side panel: the whole
     ranked list rides along in the launch extras (sources_json), so picking
     another stream re-opens mpv on that URL at the same playhead - the same
     rows, the same labels and badge chips, the same panel the main player
     shows. AUDIO and SUBTITLES read as lists there too, naming every track mpv
     found instead of stepping through them blind.

     D-pad first: the overlay appears on any key press and hides again on its
     own; while it is up the buttons take focus, exactly as in the main player. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mpv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.kennyb1201.kbstream.ui.player.MpvPlayerView
        android:id="@+id/mpv_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- Whole-screen buffering spinner for mid-playback stalls (mpv paused for
         cache). The initial load uses the splash below instead. -->
    <ProgressBar
        android:id="@+id/mpv_buffering"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/kb_accent"
        android:visibility="gone" />

    <!-- Load splash: the title's backdrop with its clear logo over it, falling
         back to the name when there is no logo art - the same shape as the main
         player's splash. -->
    <FrameLayout
        android:id="@+id/mpv_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black">

        <ImageView
            android:id="@+id/mpv_loading_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Backdrop"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/mpv_loading_logo"
            android:layout_width="420dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="Clear logo"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mpv_loading_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:fontFamily="@font/oswald_semibold"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="64dp"
            android:paddingEnd="64dp"
            android:textColor="@color/kb_text_hi"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="64dp"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/kb_accent" />

            <TextView
                android:id="@+id/mpv_loading_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/oswald_medium"
                android:gravity="center"
                android:textColor="@color/kb_text_lo"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Fatal: the stream never opened, or mpv gave up on it. -->
    <LinearLayout
        android:id="@+id/mpv_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kb_void"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="80dp"
        android:paddingEnd="80dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mpv_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald_semibold"
            android:gravity="center"
            android:textColor="@color/kb_text_hi"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/mpv_error_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/oswald_medium"
            android:gravity="center"
            android:textColor="@color/kb_text_lo"
            android:textSize="14sp" />

        <!-- Switch player: the error card's own copy of the control bar's
             SWITCH (see switchToExoPlayer), so a viewer looking at a failure
             does not have to find the bar behind a full-screen card to try the
             other engine. ExoPlayer is always there to switch to, so unlike the
             main player's copy of this button there is nothing to hide it for. -->
        <TextView
            android:id="@+id/mpv_error_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/button_surface_bg"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="@font/oswald_semibold"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="SWITCH PLAYER"
            android:textColor="@color/kb_text_hi"
            android:textSize="16sp" />

        <!-- Retry on another source: the same switch the SOURCES picker makes,
             one tap away on the failure card. Hidden when the ranked list has
             no source left, so it is never a dead end (see tryNextSource).
             Accent-filled, the app's one primary action on a card: it is what
             a viewer who reached a dead stream wants, and the native player's
             error card paints its CHANGE SOURCE the same way. -->
        <TextView
            android:id="@+id/mpv_error_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_accent_bg"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="@font/oswald_semibold"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="TRY NEXT SOURCE"
            android:textColor="@color/kb_void"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Transient feedback for the engine buttons ("Subtitles off") is a
         platform Toast, the same one the native player raises - see
         MpvPlayerActivity.showToast, which used to drive a TextView here. -->

    <!-- The shared overlay: gradient chrome, clock, title block, badges, cast
         band, seek bar and the 11 control buttons, hidden by default and driven
         by PlayerChrome. The MPV-only chapter strip is inflated into its
         chrome_extra_seek slot at runtime (see MpvPlayerActivity.bindViews), so
         it keeps the exact place it had here. Declared before the end-of-episode
         cards and side panels so those still paint above it. -->
    <include layout="@layout/player_chrome" />

    <!-- Up Next (shown as the episode's credits roll) - the same compact card
         the main player was reduced to, in the same bottom-right corner: low
         in the corner, right-aligned with the screen's own 48dp inset, and
         every field kept. The bottom inset is only a small safe-area gap
         (the control bar it used to clear is never on screen at the same time
         as this card), so the card sits just off the bottom edge. Its width is
         wrap_content rather than the 440dp the main player starts from: the
         card hugs its own widest line (the show title, capped at 240dp), so
         its right edge sits where the text ends instead of leaving the whole
         right-hand side of the card empty. -->
    <LinearLayout
        android:id="@+id/mpv_next_up_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/panel_bg"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/mpv_next_up_thumb"
            android:layout_width="150dp"
            android:layout_height="84dp"
            android:background="@color/kb_surface"
            android:contentDescription="Next episode thumbnail"
            android:scaleType="centerCrop" />

        <!-- The text column DEFINES the card's width here (see the panel
         above): no weight, no fixed width - it sizes to its own lines so the
         card ends where the text does. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mpv_next_up_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oswald_medium"
                android:letterSpacing="0.18"
                android:text="UP NEXT"
                android:textColor="@color/kb_accent"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/mpv_next_up_show_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxWidth="240dp"
                android:fontFamily="@font/oswald_medium"
                android:maxLines="1"
                android:textColor="@color/kb_text_hi"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/mpv_next_up_episode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/oswald_medium"
                android:textColor="@color/kb_accent"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/mpv_next_up_episode_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxWidth="240dp"
                android:fontFamily="@font/oswald_medium"
                android:maxLines="2"
                android:textColor="@color/kb_text_lo"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mpv_next_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="@font/oswald_semibold"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="PLAY NEXT"
                    android:textAllCaps="true"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/mpv_next_dismiss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="@font/oswald_semibold"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="EXIT"
                    android:textAllCaps="true"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/mpv_next_up_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/oswald_medium"
                android:textColor="@color/kb_text_lo"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Because-you-watched panel (shown during the end credits when there is
         no next episode to chain): TMDB recommendations for the title that
         just finished, one PLAY + one DETAILS pill per pick. The same panel and
         the same shared builder the main player uses, so an end of playback
         looks and drives the same whichever engine played it. Populated only
         when the Up Next card has nothing to hand off to. -->
    <LinearLayout
        android:id="@+id/mpv_byw_panel"
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="22dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mpv_byw_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald_medium"
            android:letterSpacing="0.18"
            android:text="BECAUSE YOU WATCHED"
            android:textColor="@color/kb_accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/mpv_byw_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/oswald_medium"
            android:maxLines="1"
            android:textColor="@color/kb_text_hi"
            android:textSize="22sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/mpv_byw_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/mpv_byw_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/oswald_medium"
            android:text="Pick a title, or press BACK to exit"
            android:textColor="@color/kb_text_lo"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Picker side panel (SOURCES / AUDIO / SUBTITLES / SPEED), the same box
         as the main player's and the same shared adapter, so the rows and the
         selection mark cannot drift between the engines. -->
    <LinearLayout
        android:id="@+id/mpv_picker_container"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="24dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mpv_picker_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald_medium"
            android:textColor="@color/kb_accent"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mpv_picker_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <!-- Settings side panel, the same box as the main player's. Its rows are
         built in code (MpvSettingsSection), so they cannot drift from the
         main player's pill styling. -->
    <ScrollView
        android:id="@+id/mpv_settings_container"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="24dp"
        android:background="@drawable/panel_bg"
        android:descendantFocusability="afterDescendants"
        android:fadeScrollbars="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollbarStyle="outsideOverlay"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oswald_medium"
                android:text="PLAYBACK SETTINGS"
                android:textColor="@color/kb_accent"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

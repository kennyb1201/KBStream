<?xml version="1.0" encoding="utf-8"?>
<!-- MPV backup player. The chrome is deliberately the same as
     activity_player.xml's: same gradient overlay, same Oswald type, same icon
     buttons in the same order, same 360dp settings side panel - so a session
     that lands here after ExoPlayer gives up looks and drives like any other.

     What is missing is missing because libmpv cannot do it, not by choice: no
     cast band and no badge row (both are ExoPlayer-session state), and no
     Dolby Vision / P5 controls (mpv has no DV path). Their replacements live in
     the settings panel behind the gear, which is where the engine-specific
     controls sit.

     The source button IS here, and so is the picker side panel: the whole
     ranked list rides along in the launch extras (sources_json), so picking
     another stream re-opens mpv on that URL at the same playhead - the same
     rows, the same labels and badge chips, the same panel the main player
     shows. AUDIO and SUBTITLES read as lists there too, naming every track mpv
     found instead of stepping through them blind.

     D-pad first: the overlay appears on any key press and hides again on its
     own; while it is up the buttons take focus, exactly as in the main player. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mpv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.kennyb1201.kbstream.ui.player.MpvPlayerView
        android:id="@+id/mpv_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- Whole-screen buffering spinner for mid-playback stalls (mpv paused for
         cache). The initial load uses the splash below instead. -->
    <ProgressBar
        android:id="@+id/mpv_buffering"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/kb_accent"
        android:visibility="gone" />

    <!-- Load splash: the title's backdrop with its clear logo over it, falling
         back to the name when there is no logo art - the same shape as the main
         player's splash. -->
    <FrameLayout
        android:id="@+id/mpv_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black">

        <ImageView
            android:id="@+id/mpv_loading_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Backdrop"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/mpv_loading_logo"
            android:layout_width="240dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="Clear logo"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mpv_loading_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:fontFamily="@font/oswald_semibold"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="64dp"
            android:paddingEnd="64dp"
            android:textColor="@color/kb_text_hi"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="64dp"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/kb_accent" />

            <TextView
                android:id="@+id/mpv_loading_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/kb_text_lo"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Fatal: the stream never opened, or mpv gave up on it. -->
    <LinearLayout
        android:id="@+id/mpv_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kb_void"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="80dp"
        android:paddingEnd="80dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mpv_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald_semibold"
            android:gravity="center"
            android:textColor="@color/kb_text_hi"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/mpv_error_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/kb_text_lo"
            android:textSize="14sp" />

        <!-- Switch player: the error card's own copy of the control bar's
             SWITCH (see switchToExoPlayer), so a viewer looking at a failure
             does not have to find the bar behind a full-screen card to try the
             other engine. ExoPlayer is always there to switch to, so unlike the
             main player's copy of this button there is nothing to hide it for. -->
        <TextView
            android:id="@+id/mpv_error_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/button_surface_bg"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="@font/oswald_semibold"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="SWITCH PLAYER"
            android:textColor="@color/kb_text_hi"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Transient feedback for the engine buttons ("Subtitles off"). -->
    <TextView
        android:id="@+id/mpv_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="150dp"
        android:background="@drawable/info_panel_bg"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/kb_text_hi"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Main controls overlay: gradient background, hidden by default. -->
    <LinearLayout
        android:id="@+id/mpv_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/overlay_gradient_bg"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:paddingVertical="16dp"
        android:visibility="gone">

        <!-- Top section: content info, bounded + scrollable so nothing is
             clipped on short screens. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/mpv_clear_logo"
                    android:layout_width="460dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Clear logo"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mpv_item_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/oswald_semibold"
                    android:textColor="@color/kb_text_hi"
                    android:textSize="30sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mpv_episode_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/oswald_medium"
                        android:letterSpacing="0.08"
                        android:textColor="@color/kb_accent"
                        android:textSize="20sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/mpv_episode_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/oswald_semibold"
                        android:maxLines="2"
                        android:textColor="@color/kb_text_hi"
                        android:textSize="22sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mpv_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/oswald_medium"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="5"
                    android:textColor="@color/kb_text_hi"
                    android:textSize="15sp"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

        <!-- The source/engine status strip, PINNED below the info scroll for the
             same reason the cast band below it is. Both of these used to be the
             last children of the scroll, so any screen with a long overview
             pushed them past the fold and clipped them until they were scrolled
             back into view. Everything the overlay shows at a fixed size now
             stays whole; only the prose scrolls.

             Badges first: the same row the main player shows and the same
             adapter that fills it (PickerAdapter.bindBadgeRow) - the source's
             own art/labels, hiding itself when the source carries none. In a
             horizontal scroller so a source carrying many chips cannot run off
             the side either, and not focusable so read-only chips never become
             a stop in the D-pad chain (touch/trackpad scrolling still works). -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:descendantFocusability="blocksDescendants"
            android:focusable="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/mpv_badge_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone" />
        </HorizontalScrollView>

        <!-- Which source is playing, which engine is playing it, and what mpv
             ended up decoding. Filled from mpv's own properties once the file
             opens. Pinned right under the badges because this line is what
             stands where the main player's badges sit. Bounded to two lines:
             as pinned chrome a long diagnostics string must not eat the info
             scroll above it. -->
        <TextView
            android:id="@+id/mpv_engine_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/oswald_medium"
            android:maxLines="2"
            android:textColor="@color/kb_accent"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Cast band: pinned between the info scroll and the seekbar, the same
             placement as the main player's, so avatars + names are always fully
             visible without scrolling. A press hands the actor id back to the
             catalog, which opens the person page and resumes this session on
             return - the main player's own navigate_actor contract. -->
        <LinearLayout
            android:id="@+id/mpv_cast_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/oswald_medium"
                android:text="CAST"
                android:textColor="@color/kb_accent"
                android:textSize="10sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/mpv_cast_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Bottom section: seekbar + controls, the same layout as the main
             player's. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/mpv_seekbar_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <SeekBar
                    android:id="@+id/mpv_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:max="10000"
                    android:nextFocusDown="@id/mpv_btn_play_pause"
                    android:paddingHorizontal="10dp"
                    android:progressBackgroundTint="@color/kb_surface_raised"
                    android:progressTint="@color/kb_accent"
                    android:splitTrack="false"
                    android:thumbTint="@color/kb_accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mpv_position"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/oswald_medium"
                        android:text="00:00"
                        android:textColor="@color/kb_text_hi"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/mpv_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/oswald_medium"
                        android:text="00:00"
                        android:textColor="@color/kb_text_hi"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Play/Pause (primary, focused by default). -->
                <ImageView
                    android:id="@+id/mpv_btn_play_pause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/control_button_bg"
                    android:contentDescription="Play/Pause"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@id/mpv_seekbar"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_player_play" />

                <!-- Next episode: the same EOF handoff the main player's button
                     makes, shown only when this session knows its episode. -->
                <ImageView
                    android:id="@+id/mpv_btn_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/control_button_bg"
                    android:contentDescription="Next episode"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@id/mpv_seekbar"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_player_next"
                    android:visibility="gone" />

                <!-- The bar is split here, exactly as the main player's is:
                     play/pause and next sit on the left, and everything that
                     configures the session - source onward - is one run on the
                     right. The dialogue boost used to be a pair of buttons in
                     that run; it lives in the settings panel now, in both
                     players. -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Source: pick a different stream for this title, in the same
                     place in the bar as the main player's button. The list the
                     session was launched with, so a pick re-opens mpv on that
                     URL at the playhead instead of handing the title back. -->
                <ImageView
                    android:id="@+id/mpv_btn_source"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/control_button_bg"
                    android:contentDescription="Change source"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@id/mpv_seekbar"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_player_sources" />

                <!-- Audio track -->
                <ImageView
                    android:id="@+id/mpv_btn_audio"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/control_button_bg"
                    android:contentDescription="Audio track"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_player_audio" />

                <!-- Subtitles -->
                <ImageView
                    android:id="@+id/mpv_btn_subtitle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/control_button_bg"
                    android:contentDescription="Subtitles"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_player_subtitle" />

                <!-- Speed: a rate is its own state, so it stays a word - in the
                     bar's typeface, which it alone was missing. -->
                <TextView
                    android:id="@+id/mpv_btn_speed"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/control_button_bg"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="@font/oswald_medium"
                    android:gravity="center"
                    android:text="1x"
                    android:textColor="@color/kb_text_hi"
                    android:textSize="14sp" />

                <!-- Aspect ratio: cycles on every press, like the main player's,
                     and shows the mode name it landed on. -->
                <TextView
                    android:id="@+id/mpv_btn_aspect"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/control_button_bg"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="@font/oswald_medium"
                    android:gravity="center"
                    android:text="Fit"
                    android:textColor="@color/kb_text_hi"
                    android:textSize="12sp" />

                <!-- Switch player: the same button and the same glyph the main
                     player's bar carries in the same place - it hands this
                     session back to ExoPlayer and resumes where it is. -->
                <ImageView
                    android:id="@+id/mpv_btn_player_switch"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/control_button_bg"
                    android:contentDescription="Switch player"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@id/mpv_seekbar"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_player_switch" />

                <!-- Play in another app: the main player's third engine, on
                     this bar too, because a viewer who opened MPV for a file
                     this TV's decoders refused may still prefer their own
                     player. Hidden when there is nothing installed to hand
                     the stream to. -->
                <ImageView
                    android:id="@+id/mpv_btn_player_external"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/control_button_bg"
                    android:contentDescription="Play in another app"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@id/mpv_seekbar"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_player_external"
                    android:visibility="gone" />

                <!-- Stream info -->
                <ImageView
                    android:id="@+id/mpv_btn_info"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/control_button_bg"
                    android:contentDescription="Stream info"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_player_info" />

                <!-- Settings -->
                <ImageView
                    android:id="@+id/mpv_btn_settings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/control_button_bg"
                    android:contentDescription="Playback settings"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_player_settings" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Skip prompt, the same button the main player shows: an IntroDB segment
         (intro, recap, outro, credits, preview, post-credits scene) the viewer
         is inside right now, with the label that segment's type asks for. It
         sits above the control bar, unmissable but out of its way, and OK
         skips the segment while the chrome is down - so an intro can be
         skipped without opening the overlay first. -->
    <TextView
        android:id="@+id/mpv_skip_intro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="96dp"
        android:background="@drawable/pill_chip_selected_bg"
        android:elevation="6dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:fontFamily="@font/oswald_semibold"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:textColor="@color/kb_void"
        android:textSize="13sp"
        android:textAllCaps="true"
        android:translationZ="4dp"
        android:visibility="gone" />

    <!-- Up Next (shown as the episode's credits roll) - the same compact card
         the main player was reduced to, in the same bottom-right corner: low
         in the corner, right-aligned with the screen's own 48dp inset, and
         every field kept. The bottom inset is only a small safe-area gap
         (the control bar it used to clear is never on screen at the same time
         as this card), so the card sits just off the bottom edge. Its width is
         wrap_content rather than the 440dp the main player starts from: the
         card hugs its own widest line (the show title, capped at 240dp), so
         its right edge sits where the text ends instead of leaving the whole
         right-hand side of the card empty. -->
    <LinearLayout
        android:id="@+id/mpv_next_up_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/panel_bg"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/mpv_next_up_thumb"
            android:layout_width="150dp"
            android:layout_height="84dp"
            android:background="@color/kb_surface"
            android:contentDescription="Next episode thumbnail"
            android:scaleType="centerCrop" />

        <!-- The text column DEFINES the card's width here (see the panel
         above): no weight, no fixed width - it sizes to its own lines so the
         card ends where the text does. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mpv_next_up_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oswald_medium"
                android:letterSpacing="0.18"
                android:text="UP NEXT"
                android:textColor="@color/kb_accent"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/mpv_next_up_show_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxWidth="240dp"
                android:fontFamily="@font/oswald_medium"
                android:maxLines="1"
                android:textColor="@color/kb_text_hi"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/mpv_next_up_episode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/oswald_medium"
                android:textColor="@color/kb_accent"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/mpv_next_up_episode_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxWidth="240dp"
                android:fontFamily="@font/oswald_medium"
                android:maxLines="2"
                android:textColor="@color/kb_text_lo"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mpv_next_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="@font/oswald_semibold"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="PLAY NEXT"
                    android:textAllCaps="true"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/mpv_next_dismiss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="@font/oswald_semibold"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="EXIT"
                    android:textAllCaps="true"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/mpv_next_up_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/oswald_medium"
                android:textColor="@color/kb_text_lo"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Because-you-watched panel (shown during the end credits when there is
         no next episode to chain): TMDB recommendations for the title that
         just finished, one PLAY + one DETAILS pill per pick. The same panel and
         the same shared builder the main player uses, so an end of playback
         looks and drives the same whichever engine played it. Populated only
         when the Up Next card has nothing to hand off to. -->
    <LinearLayout
        android:id="@+id/mpv_byw_panel"
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="22dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mpv_byw_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald_medium"
            android:letterSpacing="0.18"
            android:text="BECAUSE YOU WATCHED"
            android:textColor="@color/kb_accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/mpv_byw_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/oswald_medium"
            android:maxLines="1"
            android:textColor="@color/kb_text_hi"
            android:textSize="22sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/mpv_byw_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/mpv_byw_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/oswald_medium"
            android:text="Pick a title, or press BACK to exit"
            android:textColor="@color/kb_text_lo"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Picker side panel (SOURCES / AUDIO / SUBTITLES / SPEED), the same box
         as the main player's and the same shared adapter, so the rows and the
         selection mark cannot drift between the engines. -->
    <LinearLayout
        android:id="@+id/mpv_picker_container"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="24dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mpv_picker_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald_medium"
            android:textColor="@color/kb_accent"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mpv_picker_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <!-- Settings side panel, the same box as the main player's. Its rows are
         built in code (MpvSettingsSection), so they cannot drift from the
         main player's pill styling. -->
    <ScrollView
        android:id="@+id/mpv_settings_container"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="24dp"
        android:background="@drawable/panel_bg"
        android:descendantFocusability="afterDescendants"
        android:fadeScrollbars="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollbarStyle="outsideOverlay"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oswald_medium"
                android:text="PLAYBACK SETTINGS"
                android:textColor="@color/kb_accent"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/picker_item_bg"
    android:layout_marginVertical="4dp">

    <!-- KB-compatible stream badge chips row. Ships ABOVE the file name so the
         chips read as a header over the source they describe. PickerAdapter
         re-applies the order (and the spacing that goes with it) on every bind,
         so the "Badges above the file name" setting can move it under the name
         without a second layout. -->
    <LinearLayout
        android:id="@+id/picker_item_badges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/picker_item_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:fontFamily="@font/oswald_medium"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:textColor="@color/kb_text_hi"
        android:textSize="14sp"
        android:maxLines="5"
        android:ellipsize="end" />

</LinearLayout>

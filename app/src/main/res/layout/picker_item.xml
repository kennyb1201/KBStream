<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/picker_item_bg"
    android:addStatesFromChildren="true"
    android:layout_marginVertical="4dp">

    <!-- KB-compatible stream badge chips row. Ships ABOVE the file name so the
         chips read as a header over the source they describe. PickerAdapter
         re-applies the order (and the spacing that goes with it) on every bind,
         so the "Badges above the file name" setting can move it under the name
         without a second layout. The episode picker draws its UNAVAILABLE chip
         through the same row. -->
    <LinearLayout
        android:id="@+id/picker_item_badges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <!-- The episode still, landscape 16:9 (spec 2026-11-12) like Detail's
             episode cards and the TMDB stills themselves - the old 56x84
             portrait crop of a landscape image showed a letterboxed slice of it.
             160x90 also makes the row taller than the old 84dp thumb did.
             GONE for every row that is not an episode, so the track and source
             pickers keep the row they always had. -->
        <ImageView
            android:id="@+id/picker_item_thumb"
            android:layout_width="160dp"
            android:layout_height="90dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- The label and, when the row has one, its date (spec 2026-11-12).
                 A row rather than one string: appended to the label, a long
                 episode title would ellipsize the DATE off the end, and the date
                 is the part that must stay visible. The label takes what is
                 left and cuts first; the date keeps its own measured width. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/picker_item_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/kb_text_hi"
                    android:textSize="14sp"
                    android:maxLines="5"
                    android:ellipsize="end" />

                <!-- The episode's air date, already formatted by the builder.
                     GONE on every row that has none, so a track or source row
                     keeps exactly the row it always had. -->
                <TextView
                    android:id="@+id/picker_item_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter_regular"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:textColor="@color/kb_text_lo"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- The episode overview, small and capped: the picker is a panel,
                 not a second Detail page - one more line than the two it had
                 (spec 2026-11-12), and no further. GONE when the episode has
                 none, so it never leaves a blank slot. -->
            <TextView
                android:id="@+id/picker_item_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:maxLines="3"
                android:paddingTop="2dp"
                android:textColor="@color/kb_text_lo"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_marginEnd="10dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:background="@drawable/picker_item_bg"
    android:padding="4dp"
    android:nextFocusDown="@id/btn_play_pause">

    <ImageView
        android:id="@+id/cast_member_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:contentDescription="Cast member photo"
        android:background="@drawable/circle_avatar_bg"
        android:clipToOutline="true" />

    <TextView
        android:id="@+id/cast_member_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/oswald_medium"
        android:textColor="@color/kb_text_hi"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:maxWidth="72dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/cast_member_character"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/oswald_medium"
        android:textColor="@color/kb_text_lo"
        android:textSize="8sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:maxWidth="72dp"
        android:gravity="center"
        android:visibility="gone" />
</LinearLayout>

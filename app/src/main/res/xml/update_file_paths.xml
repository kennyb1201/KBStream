<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider paths for the in-app updater: only the staged-update
     directory is shared, and only with the system install flow. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path
        name="updates"
        path="updates/" />
    <!-- The Year in review share card (spec 2026-11-13, F2). Written on demand,
         granted one URI at a time to whatever the viewer picks in the system
         share sheet, and never offered anywhere else. -->
    <cache-path
        name="share"
        path="share/" />
</paths>

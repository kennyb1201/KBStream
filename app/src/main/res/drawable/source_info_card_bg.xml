<?xml version="1.0" encoding="utf-8"?>
<!-- Card behind the player overlay's grouped source info: rounded surface
     with a faint accent border so the technical block reads as one unit
     without fighting the gradient behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#CC1D2530" />
    <stroke
        android:width="1dp"
        android:color="#2BE8A33D" />
    <corners android:radius="12dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Background for the media scrub bar. Shows a subtle rounded panel that
     lights up with an accent ring + fill when the D-pad focuses it, so it is
     obvious on TV that the seek bar has focus and you can begin scrubbing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kb_surface" />
            <corners android:radius="10dp" />
            <stroke
                android:width="2dp"
                android:color="@color/kb_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
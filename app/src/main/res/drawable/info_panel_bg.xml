<?xml version="1.0" encoding="utf-8"?>
<!-- The player's info panel fill: SOLID.

     It used to be translucent (#CC10141B) so the video stayed visible behind
     the text, but that is exactly what made the panel unreadable: the player's
     own overlay gradient and the video behind it washed through the codec
     lines. Both players also re-resolve this at runtime through
     infoPanelDrawable(), which is what makes the fill follow the AMOLED /
     pure-black toggles; the color here is the fallback for the moment before
     that runs. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/kb_surface_raised" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#40E8A33D" />
</shape>

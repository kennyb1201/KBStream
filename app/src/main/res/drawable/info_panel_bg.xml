<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent info panel: video stays visible behind the text
     (shape color carries the alpha; no theme attr needed). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#CC10141B" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#40E8A33D" />
</shape>

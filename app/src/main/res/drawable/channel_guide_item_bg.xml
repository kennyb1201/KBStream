<?xml version="1.0" encoding="utf-8"?>
<!-- Row background for the in-player channel guide. A selector rather than a
     ripple: the guide is D-pad driven, and what has to be unmistakable is which
     row currently has focus (a ripple is invisible on a remote). The focused
     state is the same one every other focused surface in the app draws
     (mpv_control_bg included): a raised fill behind a 2dp accent stroke, so
     both players' focus language matches.
     The unfocused selected state marks the channel playing right now: it keeps
     a hairline accent outline so "you are here" survives scrolling away from
     the focused row. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kb_surface_raised" />
            <stroke
                android:width="2dp"
                android:color="@color/kb_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kb_surface_raised" />
            <stroke
                android:width="1dp"
                android:color="@color/kb_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kb_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/kb_overlay_gradient_mid" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>

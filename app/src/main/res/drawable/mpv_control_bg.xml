<?xml version="1.0" encoding="utf-8"?>
<!-- Control-button background for the MPV backup player. A selector rather
     than a ripple: this player is driven by a D-pad, and what has to be
     unmistakable is which button currently has focus (a plain ripple is
     invisible on a TV remote). The focused state reuses the accent stroke
     convention of button_accent_bg_focused / pill_chip_focused_bg. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kb_surface_raised" />
            <stroke
                android:width="2dp"
                android:color="@color/kb_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kb_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/kb_overlay_gradient_mid" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>

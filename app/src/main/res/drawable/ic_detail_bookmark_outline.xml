<!-- Add to Library: an outline bookmark.

     The unsaved state of the detail header's Library toggle (see
     ic_detail_bookmark_filled, and ic_detail_trailer for the row's geometry):
     24x24 viewport, same 4.6-unit side margin the plus arms had, so the button
     does not change size, weight or position when the mark fills. One mark that
     fills once it is saved, rather than two unrelated glyphs.

     Path data is Google's Material Icons "bookmark_border" (24 unit viewport),
     copied rather than hand-drawn: the outer silhouette runs x 5..19 and y
     3..21, and the border is a full 2 units thick on both sides and the top, so
     the outline holds up at the 18dp the header renders it at and the foot
     notch stays visibly open. Carries kb_text_hi (#FFF3EFE4) baked in, like
     every other glyph in the row. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFF3EFE4"
        android:pathData="M17,3H7c-1.1,0 -2,0.9 -2,2v16l7,-3 7,3V5c0,-1.1 -0.9,-2 -2,-2zM17,18l-5,-2.18L7,18V5h10v13z" />
</vector>

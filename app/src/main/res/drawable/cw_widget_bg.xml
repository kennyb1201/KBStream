<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's shell: a rounded card in the app's own palette.

     Same tokens as the app (`kb_surface`, `kb_text_hi`, `kb_accent`), because a
     widget is the app's face on the launcher - a white default card with a black
     title would look like a different product. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/kb_surface" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="#33F3EFE4" />
</shape>

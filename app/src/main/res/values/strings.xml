<?xml version="1.0" encoding="utf-8"?>
<!--
  KBStream is a single-language app by decision, not by neglect: the whole UI is
  written in English and `stringResource()` is not used anywhere in the tree.
  The reasoning is that the user-visible surface is dense and TV-specific
  ("CATCH-UP TV", "HIDE GROUP", "Press OK to retry.") and the app has no
  translation workflow behind it, so moving strings into resources would add a
  layer nothing currently reads while every new string would still be written
  once, in English.

  If localization is ever picked up, this file is the place it starts: user-
  visible strings move here and the screens switch to `stringResource()`.
  Until then, keep new copy consistent with the existing voice rather than
  inventing a parallel convention.

  The two entries below are the exception the rule allows: media3's
  DownloadService takes its notification channel's name and description as
  @StringRes ids, so these two strings cannot be inline Kotlin. They are the
  only resources here, and they are here because the API demands resources.
-->
<resources>
    <string name="downloads_channel_name">Downloads</string>
    <string name="downloads_channel_description">Keeps a download going and shows its progress.</string>
</resources>
